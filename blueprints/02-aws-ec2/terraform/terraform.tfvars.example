# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in your values.
# Never commit terraform.tfvars to version control — it may contain sensitive data.
#
# ──────────────────────────────────────────────────────────────────────────────
# MODE A: Bring Your Own VPC (default)
#
# Use this when you already have an AWS VPC with a private subnet and NAT Gateway
# (or VPC endpoints for SSM). Set create_vpc = false (the default) and supply:
# ──────────────────────────────────────────────────────────────────────────────

# create_vpc = false   # default — omit or set explicitly

vpc_id            = "vpc-xxxxxxxx"
private_subnet_id = "subnet-xxxxxxxx"

# Operating system selection — drives cloud-init template and AMI choice.
# Supported values: ubuntu-2404 (recommended), ubuntu-2204, debian-12,
#                   centos-9, rhel-9, rhel-10, almalinux-9, oracle-9, rocky-9
os_type = "ubuntu-2404"

# AMI ID — must match the selected os_type.
# Find the latest AMI for each OS using the lookup commands below.
#
# Ubuntu 24.04 LTS (Noble) — recommended
#   aws ec2 describe-images \
#     --owners 099720109477 \
#     --filters 'Name=name,Values=ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*' \
#               'Name=state,Values=available' \
#     --query 'sort_by(Images,&CreationDate)[-1].ImageId' --output text
#
# Ubuntu 22.04 LTS (Jammy)
#   aws ec2 describe-images \
#     --owners 099720109477 \
#     --filters 'Name=name,Values=ubuntu/images/hvm-ssd-gp3/ubuntu-jammy-22.04-amd64-server-*' \
#               'Name=state,Values=available' \
#     --query 'sort_by(Images,&CreationDate)[-1].ImageId' --output text
#
# Debian 12 (Bookworm)
#   aws ec2 describe-images \
#     --owners 136693071363 \
#     --filters 'Name=name,Values=debian-12-amd64-*' \
#               'Name=state,Values=available' \
#     --query 'sort_by(Images,&CreationDate)[-1].ImageId' --output text
#
# CentOS Stream 9
#   aws ec2 describe-images \
#     --owners 125523088429 \
#     --filters 'Name=name,Values=CentOS Stream 9*' \
#               'Name=state,Values=available' \
#     --query 'sort_by(Images,&CreationDate)[-1].ImageId' --output text
#
# RHEL 9 (Red Hat official)
#   aws ec2 describe-images \
#     --owners 309956199498 \
#     --filters 'Name=name,Values=RHEL-9*GA*' \
#               'Name=architecture,Values=x86_64' \
#               'Name=state,Values=available' \
#     --query 'sort_by(Images,&CreationDate)[-1].ImageId' --output text
#
# RHEL 10 (Red Hat official)
#   aws ec2 describe-images \
#     --owners 309956199498 \
#     --filters 'Name=name,Values=RHEL-10*GA*' \
#               'Name=architecture,Values=x86_64' \
#               'Name=state,Values=available' \
#     --query 'sort_by(Images,&CreationDate)[-1].ImageId' --output text
#
# AlmaLinux 9
#   aws ec2 describe-images \
#     --owners 764336703387 \
#     --filters 'Name=name,Values=AlmaLinux OS 9*' \
#               'Name=state,Values=available' \
#     --query 'sort_by(Images,&CreationDate)[-1].ImageId' --output text
#
# Oracle Linux 9
#   aws ec2 describe-images \
#     --owners 131827586825 \
#     --filters 'Name=name,Values=OL9*' \
#               'Name=state,Values=available' \
#     --query 'sort_by(Images,&CreationDate)[-1].ImageId' --output text
#
# Rocky Linux 9
#   aws ec2 describe-images \
#     --owners 792107900699 \
#     --filters 'Name=name,Values=Rocky-9-*' \
#               'Name=state,Values=available' \
#     --query 'sort_by(Images,&CreationDate)[-1].ImageId' --output text
#
ami_id = "ami-xxxxxxxx"

# Recommended: attach an IAM instance profile so SSM Session Manager works
# (no bastion host or open SSH port needed — IAM-controlled + CloudTrail-logged)
iam_instance_profile_name = "aidome-ssm-profile" # must have AmazonSSMManagedInstanceCore

# Optional: allow SSH from a narrow internal CIDR (SSM is preferred)
# allowed_ssh_cidr = "10.0.0.0/8"
# key_name         = "my-key-pair"

# Instance sizing — t3.small is the minimum for AIDome
instance_type    = "t3.small"
root_volume_size = 30 # GiB — increase if large model artefacts will be stored locally

# Optional: customer-managed KMS key for EBS encryption
# (omit to use the default AWS managed key aws/ebs)
# kms_key_id = "arn:aws:kms:us-east-1:123456789012:key/mrk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Resource name prefix and tags
name_prefix = "aidome-ec2"
tags = {
  Environment = "dev"
  Project     = "aidome"
  ManagedBy   = "terraform"
}

# ──────────────────────────────────────────────────────────────────────────────
# MODE B: Greenfield — Terraform creates the full networking stack
#
# Use this when you have no existing VPC. Set create_vpc = true and omit
# vpc_id / private_subnet_id. Terraform will create:
#   VPC, public subnet, private subnet, Internet Gateway, NAT Gateway,
#   Elastic IP, and route tables — all in a single apply.
# ──────────────────────────────────────────────────────────────────────────────

# create_vpc = true
#
# vpc_cidr            = "10.0.0.0/16"   # default
# public_subnet_cidr  = "10.0.0.0/24"  # default
# private_subnet_cidr = "10.0.1.0/24"  # default
# availability_zone   = "us-east-1a"   # optional; defaults to first available AZ

